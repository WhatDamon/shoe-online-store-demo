APP_ENV=development
DATABASE_URL=sqlite:///./commerce.db
# Shared only between the Next server and Python service. Production requires at
# least 32 random bytes; leave empty for the local direct-service demo.
COMMERCE_PROXY_SECRET=
# Production: APP_ENV=production and an explicit TLS identity check are required:
# DATABASE_URL=postgresql+psycopg://user:password@db.example:5432/evoloop?sslmode=verify-full
# Add sslrootcert=/path/to/trusted-ca.pem when the server certificate is not in
# the system trust store.

# Persisted deadline for new orders; existing deadlines never change on restart.
RESERVATION_TTL_SECONDS=1800
RESERVATION_SWEEP_SECONDS=30
RESERVATION_SWEEP_BATCH_SIZE=100
RESERVATION_SWEEPER_ENABLED=true

# Test runner only: set this as a process environment variable to add real PostgreSQL tests.
# Use an empty dedicated database whose name ends in _test; never use a production URL.
# COMMERCE_TEST_POSTGRES_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/commerce_test
