{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:boundary": "node scripts/check-server-boundary.mjs",
    "check:coupling": "node scripts/check-coupling.mjs",
    "check:catalog": "node scripts/check-catalog-drift.mjs",
    "check:slop": "node scripts/check-slop.mjs",
    "py": "node scripts/py.mjs",
    "check:python:format": "node scripts/py.mjs -m ruff format --check app migrations tests",
    "check:python:lint": "node scripts/py.mjs -m ruff check app migrations tests",
    "check:python:types": "node scripts/py.mjs -m mypy",
    "check:python:migrate": "node scripts/py.mjs -m alembic check",
    "check:slop:python": "node scripts/py.mjs ../scripts/check-slop-python.py",
    "compile:python": "node scripts/py.mjs -m compileall app",
    "test:slop:python": "node scripts/py.mjs ../scripts/check-slop-python.py --self-test",
    "test:python": "node scripts/py.mjs -m pytest -q",
    "smoke:commerce": "node scripts/py.mjs ../scripts/smoke-commerce.py",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate:python": "node scripts/py.mjs -m alembic upgrade head",
    "preflight": "node scripts/preflight.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run typecheck && npm run check:boundary && npm run check:coupling && npm run check:catalog && npm run check:slop && npm run lint && npm run test",
    "verify:python": "npm run check:python:format && npm run check:python:lint && npm run check:python:types && npm run compile:python && npm run check:python:migrate && npm run check:slop:python && npm run test:slop:python && npm run test:python",
    "verify:all": "npm run verify && npm run verify:python"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "npm@12.0.1"
}
