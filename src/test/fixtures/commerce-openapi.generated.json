{
  "components": {
    "schemas": {
      "AddItem": {
        "properties": {
          "quantity": { "maximum": 99, "minimum": 1, "title": "Quantity", "type": "integer" },
          "variant_id": { "format": "uuid", "title": "Variant Id", "type": "string" }
        },
        "required": ["quantity", "variant_id"],
        "title": "AddItem",
        "type": "object"
      },
      "CartItemResponse": {
        "properties": {
          "available": { "minimum": 0, "title": "Available", "type": "integer" },
          "color": { "title": "Color", "type": "string" },
          "id": { "title": "Id", "type": "string" },
          "quantity": { "maximum": 99, "minimum": 1, "title": "Quantity", "type": "integer" },
          "sellable": { "title": "Sellable", "type": "boolean" },
          "size": { "title": "Size", "type": "integer" },
          "sku": { "title": "Sku", "type": "string" },
          "subtotal": {
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "title": "Subtotal",
            "type": "string"
          },
          "title": { "title": "Title", "type": "string" },
          "unit_price": {
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "title": "Unit Price",
            "type": "string"
          },
          "variant_id": { "title": "Variant Id", "type": "string" }
        },
        "required": [
          "id",
          "variant_id",
          "title",
          "sku",
          "color",
          "size",
          "quantity",
          "unit_price",
          "subtotal",
          "available",
          "sellable"
        ],
        "title": "CartItemResponse",
        "type": "object"
      },
      "CartResponse": {
        "properties": {
          "currency": { "pattern": "^[A-Z]{3}$", "title": "Currency", "type": "string" },
          "items": {
            "items": { "$ref": "#/components/schemas/CartItemResponse" },
            "title": "Items",
            "type": "array"
          },
          "total": { "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$", "title": "Total", "type": "string" }
        },
        "required": ["items", "total", "currency"],
        "title": "CartResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": { "pattern": "^[a-z][a-z0-9_]{0,63}$", "title": "Code", "type": "string" },
          "detail": { "title": "Detail", "type": "string" }
        },
        "required": ["code", "detail"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "payment_enabled": { "const": false, "title": "Payment Enabled", "type": "boolean" },
          "status": { "const": "ok", "title": "Status", "type": "string" }
        },
        "required": ["status", "payment_enabled"],
        "title": "HealthResponse",
        "type": "object"
      },
      "MediaResponse": {
        "properties": {
          "color": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Color" },
          "url": { "title": "Url", "type": "string" }
        },
        "required": ["url", "color"],
        "title": "MediaResponse",
        "type": "object"
      },
      "OrderItemResponse": {
        "properties": {
          "color": { "title": "Color", "type": "string" },
          "id": { "title": "Id", "type": "string" },
          "quantity": { "maximum": 99, "minimum": 1, "title": "Quantity", "type": "integer" },
          "size": { "title": "Size", "type": "integer" },
          "sku": { "title": "Sku", "type": "string" },
          "title": { "title": "Title", "type": "string" },
          "unit_price": {
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "title": "Unit Price",
            "type": "string"
          },
          "variant_id": { "title": "Variant Id", "type": "string" }
        },
        "required": ["id", "variant_id", "title", "sku", "color", "size", "quantity", "unit_price"],
        "title": "OrderItemResponse",
        "type": "object"
      },
      "OrderResponse": {
        "properties": {
          "cancellation_reason": {
            "anyOf": [
              { "enum": ["expired", "customer_cancelled"], "type": "string" },
              { "type": "null" }
            ],
            "title": "Cancellation Reason"
          },
          "currency": { "pattern": "^[A-Z]{3}$", "title": "Currency", "type": "string" },
          "expires_at": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Expires At"
          },
          "id": { "title": "Id", "type": "string" },
          "items": {
            "items": { "$ref": "#/components/schemas/OrderItemResponse" },
            "title": "Items",
            "type": "array"
          },
          "message": { "title": "Message", "type": "string" },
          "payment_enabled": { "const": false, "title": "Payment Enabled", "type": "boolean" },
          "status": {
            "enum": ["pending_payment", "cancelled"],
            "title": "Status",
            "type": "string"
          },
          "total": { "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$", "title": "Total", "type": "string" }
        },
        "required": [
          "id",
          "status",
          "expires_at",
          "cancellation_reason",
          "total",
          "currency",
          "payment_enabled",
          "message",
          "items"
        ],
        "title": "OrderResponse",
        "type": "object"
      },
      "PaymentRequest": {
        "properties": { "order_id": { "format": "uuid", "title": "Order Id", "type": "string" } },
        "required": ["order_id"],
        "title": "PaymentRequest",
        "type": "object"
      },
      "PaymentResponse": {
        "properties": {
          "charged": { "const": false, "title": "Charged", "type": "boolean" },
          "code": { "const": "payment_disabled", "title": "Code", "type": "string" },
          "message": { "title": "Message", "type": "string" },
          "order_id": { "title": "Order Id", "type": "string" },
          "order_status": {
            "enum": ["pending_payment", "cancelled"],
            "title": "Order Status",
            "type": "string"
          },
          "payment_enabled": { "const": false, "title": "Payment Enabled", "type": "boolean" },
          "provider": { "const": "mock", "title": "Provider", "type": "string" }
        },
        "required": [
          "code",
          "payment_enabled",
          "provider",
          "charged",
          "order_id",
          "order_status",
          "message"
        ],
        "title": "PaymentResponse",
        "type": "object"
      },
      "ProductResponse": {
        "properties": {
          "description": { "title": "Description", "type": "string" },
          "handle": { "title": "Handle", "type": "string" },
          "id": { "title": "Id", "type": "string" },
          "media": {
            "items": { "$ref": "#/components/schemas/MediaResponse" },
            "title": "Media",
            "type": "array"
          },
          "title": { "title": "Title", "type": "string" },
          "variants": {
            "items": { "$ref": "#/components/schemas/VariantResponse" },
            "title": "Variants",
            "type": "array"
          }
        },
        "required": ["id", "handle", "title", "description", "media", "variants"],
        "title": "ProductResponse",
        "type": "object"
      },
      "Quantity": {
        "properties": {
          "quantity": { "maximum": 99, "minimum": 1, "title": "Quantity", "type": "integer" }
        },
        "required": ["quantity"],
        "title": "Quantity",
        "type": "object"
      },
      "VariantResponse": {
        "properties": {
          "available": { "minimum": 0, "title": "Available", "type": "integer" },
          "color": { "title": "Color", "type": "string" },
          "color_hex": { "title": "Color Hex", "type": "string" },
          "currency": { "pattern": "^[A-Z]{3}$", "title": "Currency", "type": "string" },
          "id": { "title": "Id", "type": "string" },
          "price": {
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "title": "Price",
            "type": "string"
          },
          "size": { "title": "Size", "type": "integer" },
          "sku": { "title": "Sku", "type": "string" }
        },
        "required": ["id", "sku", "color", "color_hex", "size", "price", "currency", "available"],
        "title": "VariantResponse",
        "type": "object"
      }
    }
  },
