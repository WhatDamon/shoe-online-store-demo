# Copy to .env.local, then adjust. Nothing here is secret by default:
# with an empty AI_API_KEY the assistant runs in built-in Mock mode (free, deterministic).

# --- Market ---------------------------------------------------------------
# Single market per deployment (spec decision #9: config-level, no runtime switching).
# US|EU|UK|JP|CN — drives the size-display system and conversions (foot-length-mm anchored).
SITE_MARKET=US

# --- AI (OpenAI-compatible) ------------------------------------------------
# Leave AI_API_KEY empty -> Mock mode (zero cost, demo-ready, deterministic answers).
# Real mode activates only when AI_API_KEY is set (and AI_DISABLE_REAL != '1').
AI_API_KEY=
# Base URL for an OpenAI-compatible endpoint. Empty = official OpenAI API.
AI_BASE_URL=
# Chat model. Default used by the real provider when unset: gpt-5.6-luna
# (2026-09: gpt-4o-mini deprecated-era; the GPT-5.6 budget tier replaced the nano class.
#  Quality-upgrade option: gpt-5.6-terra. Any OpenAI-compatible gateway name works.).
AI_MODEL=gpt-5.6-luna
# Embedding model for semantic search. Still the cheapest current model ($0.02/1M);
# the only alternatives are text-embedding-3-large. Empty + empty AI_BASE_URL -> keyword search fallback.
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI guardrails (spec §8.5) ---------------------------------------------
# Per anonymous session turn cap (soft message when exceeded; suggest a new chat).
AI_MAX_TURNS=20
# Max output tokens per provider response.
AI_MAX_OUTPUT_TOKENS=500
# Per-request provider timeout in ms.
AI_REQUEST_TIMEOUT_MS=20000
# Max characters for a single incoming user message.
AI_MAX_MESSAGE_CHARS=800
# Daily token budget across all anonymous sessions (SUM of ai_usage per UTC day).
# Exceeded -> soft refusal ("taking a short break").
AI_DAILY_TOKEN_CAP=1000000
# Kill switch: set to 1 to force Mock mode even with a key (abuse response).
AI_DISABLE_REAL=0

# --- Database ----------------------------------------------------------------
# App DB driver (spec decision #13). sqlite (default): local file via bun:sqlite —
# zero-setup, used by dev/tests, Bun-only. postgres: managed Postgres (e.g. Cloud
# SQL) via postgres.js — works on Bun and Node runtimes alike. Read lazily at first
# db access; unknown values fail fast at boot.
DB_DRIVER=sqlite

# 目录运行时源（决策 #17）：db = products 表（默认，表空自动从导入层灌种）；
# seed = 纯内存导入层（单元测试）；shopify 仍由下方 SHOPIFY_* 双配置优先触发。
# CATALOG_SOURCE=db
# sqlite: file path (created on first run; both drivers auto-create their schema via
# CREATE TABLE IF NOT EXISTS — no migration step).
# postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=./data/local.db

# --- Shopify (reserved; decision #19 removed the Buy Button demo) -----------------
# Store myshopify domain prefix for Evoloop product deep links / future adapters.
SHOPIFY_DOMAIN =
# Reserved for a future direct Storefront read (spec decision #14).
SHOPIFY_STOREFRONT_TOKEN =
