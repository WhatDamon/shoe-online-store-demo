# Shared configuration: copy to .env, then adjust. Next reads .env and .env.local on top
# of it; Python reads .env only. Keys both sides need (e.g. COMMERCE_PROXY_SECRET) must
# therefore live in .env, and .env.local is for Next-only overrides.
# Nothing here is secret by default:
# with an empty AI_API_KEY the assistant runs in built-in Mock mode (free, deterministic).

# --- Market ---------------------------------------------------------------
# Single market per deployment (spec decision #9: config-level, no runtime switching).
# US|EU|UK|JP|CN — drives the size-display system and conversions (foot-length-mm anchored).
SITE_MARKET=US

# --- Public SEO ------------------------------------------------------------
# Canonical origin used for absolute URLs, Open Graph images, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://evoloop.site

# --- AI (OpenAI-compatible) ------------------------------------------------
# Leave AI_API_KEY empty -> Mock mode (zero cost, demo-ready, deterministic answers).
# Real mode activates only when AI_API_KEY is set (and AI_DISABLE_REAL != '1').
AI_API_KEY=
# Base URL for an OpenAI-compatible endpoint. Empty = official OpenAI API.
AI_BASE_URL=
# Chat model. Default used by the real provider when unset: gpt-5.6-luna
# (2026-09: gpt-4o-mini deprecated-era; the GPT-5.6 budget tier replaced the nano class.
#  Quality-upgrade option: gpt-5.6-terra. Any OpenAI-compatible gateway name works.).
AI_MODEL=gpt-5.6-luna
# Ask streaming-compatible providers to return exact prompt/completion usage.
# Set to 0 only for a gateway that rejects stream_options; budget settlement then uses estimates.
AI_INCLUDE_USAGE=1
# Embedding model for semantic search. Still the cheapest current model ($0.02/1M);
# the only alternatives are text-embedding-3-large. Empty + empty AI_BASE_URL -> keyword search fallback.
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI guardrails (spec §8.5) ---------------------------------------------
# Per anonymous session turn cap (soft message when exceeded; hard maximum 100).
AI_MAX_TURNS=20
# Max output tokens per provider response (hard maximum 2000).
AI_MAX_OUTPUT_TOKENS=500
# Per-request provider timeout in ms (hard maximum 120000).
# Also bounds streaming; SDK automatic retries are disabled (one reservation per attempt).
AI_REQUEST_TIMEOUT_MS=20000
# Max characters for a single incoming user message (hard maximum 4000).
AI_MAX_MESSAGE_CHARS=800
# Daily UTC estimated-token budget: atomic reservation and completed-usage settlement.
# Provider failures/timeouts/interruption consume the full estimate as 'abandoned'.
# Embedding probe/query/batch calls use separate reservations in the same daily cap;
# their input token estimate is settled with completionTokens=0.
# Only work that never called the provider may release its reservation.
# Pending work older than max(5 minutes, 3*timeout+1 minute) is recovered in batches of 100;
# at most one recovery scan per minute per instance, triggered by reservation attempts.
# Optional isolated integration tests only; never set to a business database.
# AI_TEST_POSTGRES_URL=postgresql://postgres@127.0.0.1:5432/commerce_test
# AI_TEST_POSTGRES_MIGRATIONS_URL=postgresql://postgres@127.0.0.1:5432/typescript_migrations_test
# AI_TEST_POSTGRES_TLS_URL=postgresql://postgres@localhost:5432/commerce_test
# TLS test server must use the public localhost certificate in src/test/fixtures.
# Exceeded -> soft refusal ("taking a short break").
AI_DAILY_TOKEN_CAP=1000000
# Values above the hard maximum of 10000000 are clamped.
# Kill switch: set to 1 to force Mock mode even with a key (abuse response).
AI_DISABLE_REAL=0
# Required in production: a private random secret with at least 32 characters.
# Generate locally; never commit it or reuse it as a public/commerce credential.
AI_SESSION_SECRET=
# Exact immediate proxy IPs, comma-separated. The proxy must strip incoming XFF.
# If the runtime supplies no peer IP, requests share the safe untrusted bucket.
TRUSTED_PROXY_IPS=

# --- Database ----------------------------------------------------------------
# Deployment mode. Keep development for local SQLite; production preflight requires
# APP_ENV=production and the backend enforces the same boundary.
APP_ENV=development
# App DB driver (spec decision #13). sqlite (default): local file via better-sqlite3 —
# zero-setup, runs under Node (spec decision #18 de-Bun'd the driver; Bun is the package
# manager only). postgres: managed Postgres (e.g. Cloud SQL) via postgres.js — works on
# Node and Bun runtimes alike. Read lazily at first db access; unknown values fail fast.
DB_DRIVER=sqlite

# 目录运行时源（决策 #17）：db = products 表（默认，表空自动从导入层灌种）；
# seed = 纯内存导入层（单元测试）。任何其它取值（含历史取值）一律回落 db。
# CATALOG_SOURCE=db
# sqlite: file path (created on first run; both drivers auto-create their schema via
# CREATE TABLE IF NOT EXISTS — no migration step).
# postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=./data/local.db
# Production PostgreSQL always verifies TLS certificates and endpoint identity.
# Use system-trusted certificates or mount the trusted CA bundle below.
# Development only: PG_SSL=0 allows a local plaintext PostgreSQL connection.
# NODE_TLS_REJECT_UNAUTHORIZED=0 is rejected when NODE_ENV=production.
# PG_SSL=1
# PG_SSL_CA_FILE=/run/secrets/postgres-ca.pem

# --- Local commerce -------------------------------------------------------
# Server-only Python URL. Keep Python bound to loopback for this local MVP.
PYTHON_API_URL=http://127.0.0.1:8000
# Shared only between the Next server and Python service. Production requires at
# least 32 random bytes; never expose this value to browser code.
COMMERCE_PROXY_SECRET=

# --- Stripe (Python) ------------------------------------------------------
# This root .env is the single source for both Next and Python; backend/.env is
# no longer required and only overrides it locally.
# Python's commerce database. It is not the DATABASE_URL above: that key is the
# Next/Drizzle display+AI database (./data/local.db), a different file. Paths resolve
# from backend/, so this default is backend/commerce.db; production requires
# PostgreSQL with sslmode=verify-full.
COMMERCE_DATABASE_URL=sqlite:///./commerce.db
# Payments stay off unless STRIPE_ENABLED=true. While off, nothing in this
# section is validated and no order is ever charged.
STRIPE_ENABLED=false
# Stripe API secret key. Read by the Python service only (never by browser
# code); required once STRIPE_ENABLED=true, otherwise the backend refuses to
# start rather than accept a half-configured payment path.
STRIPE_SECRET_KEY=
# Outbound Stripe call timeout in seconds (allowed range 1-60).
STRIPE_API_TIMEOUT_SECONDS=10
# Absolute origin used for Stripe success/cancel URLs. Python reuses
# NEXT_PUBLIC_SITE_URL above by default; uncomment only when the checkout origin
# differs. Must be an absolute URL, and https in production.
# PUBLIC_SITE_URL=https://evoloop.site
# Webhook signing secret, verified by the Next webhook route only (the Python
# service never reads it). Required in production once STRIPE_ENABLED=true.
STRIPE_WEBHOOK_SECRET=
