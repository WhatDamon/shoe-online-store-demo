{%- liquid
  assign evo_title = product.title | escape
  assign evo_pattern = product.metafields.evoloop.construction_pattern.value | default: 'lattice'
  assign evo_density = product.metafields.evoloop.construction_density.value | default: '0.75'
  assign evo_palette = product.metafields.evoloop.visual_palette.value | default: ''
  assign evo_accent = product.metafields.evoloop.visual_accent.value | default: ''
-%}
<div
  class="evo-visual"
  data-evo-visual
  data-name="{{ evo_title }}"
  data-pattern="{{ evo_pattern | downcase | escape }}"
  data-density="{{ evo_density | escape }}"
  data-palette="{{ evo_palette | escape }}"
  data-accent="{{ evo_accent | escape }}"
></div>
<style>
  /* Evoloop 3D-print visual fallback — self-contained, host-agnostic. */
  .evo-visual {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 1rem;
    background: #fff;
  }
  .evo-visual__canvas {
    aspect-ratio: 1 / 1;
    width: 100%;
    max-height: 100%;
    display: grid;
    place-items: center;
  }
  .evo-visual__svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .evo-visual__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .evo-visual__tab {
    border: 1px solid #ccd1cb;
    background: #fff;
    color: #1d2420;
    font: inherit;
    font-size: 0.8rem;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
  }
  .evo-visual__tab:hover {
    border-color: #1d2420;
  }
  .evo-visual__tab.is-active {
    border-color: #1d2420;
    background: #1d2420;
    color: #fff;
  }
  .evo-visual__tab:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 2px;
  }
</style>
