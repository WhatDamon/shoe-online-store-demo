{%- comment -%}
  Evoloop brand layer include — load LAST in <head> (right after Horizon's
  color-palette snippet) so the stylesheet overrides theme default fonts and
  paints the Evoloop palette tokens. Newsreader loads from Google Fonts with
  system serif fallbacks; body stays on the system sans stack (no webfont).
{%- endcomment -%}
<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
>
<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
>
{{ 'evoloop-brand.css' | asset_url | stylesheet_tag }}
