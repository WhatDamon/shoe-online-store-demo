{% liquid
  assign login_title = 'Welcome back'
  assign login_subtitle = 'Sign in to manage your orders and continue shopping.'
%}

<main class="reference-login-page" id="MainContent">
  <div class="reference-login-page__brand">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if settings.logo %}
        {{ settings.logo | image_url: width: 360 | image_tag: widths: '180, 360', loading: 'eager', alt: shop.name }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>
  </div>

  <div class="reference-login-page__card">
    <div class="reference-login-page__intro">
      <p class="reference-login-page__eyebrow">{{ shop.name }}</p>
      <h1>{{ login_title }}</h1>
      <p>{{ login_subtitle }}</p>
    </div>

    {% form 'customer_login', class: 'reference-login-form' %}
      {% if form.errors %}
        <div class="reference-login-form__error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <label for="CustomerEmail">Email address</label>
      <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>

      <label for="CustomerPassword">Password</label>
      <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>

      <button type="submit" class="reference-login-form__submit">Sign in</button>

      <a class="reference-login-form__recover" href="#recover">Forgot password?</a>
    {% endform %}

    <div class="reference-login-page__divider"><span>New here?</span></div>
    <a class="reference-login-page__register" href="{{ routes.account_register_url }}">Create an account</a>

    <div id="recover" class="reference-recover-form">
      <h2>Reset your password</h2>
      <p>Enter your email and we will send you a reset link.</p>
      {% form 'recover_customer_password', class: 'reference-login-form' %}
        {% if form.posted_successfully? %}
          <p class="reference-login-form__success" role="status">Check your email for the reset link.</p>
        {% endif %}
        <label for="RecoverEmail">Email address</label>
        <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
        <button type="submit" class="reference-login-form__submit">Send reset link</button>
      {% endform %}
    </div>
  </div>
</main>

<style>
  .reference-login-page {
    min-height: 75vh;
    padding: clamp(2rem, 6vw, 5rem) 1rem;
    background: #fff7fb;
  }

  .reference-login-page__brand {
    width: min(100%, 18rem);
    margin: 0 auto 2rem;
    text-align: center;
  }

  .reference-login-page__brand a {
    color: #e5007e;
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none;
  }

  .reference-login-page__brand img {
    width: auto;
    max-width: 100%;
    max-height: 3.5rem;
    margin-inline: auto;
    object-fit: contain;
  }

  .reference-login-page__card {
    width: min(100%, 27rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid #f0d9e6;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 16px 48px rgb(120 32 83 / 10%);
  }

  .reference-login-page__intro {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .reference-login-page__eyebrow {
    margin: 0 0 0.5rem;
    color: #e5007e;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reference-login-page h1,
  .reference-recover-form h2 {
    margin: 0 0 0.5rem;
  }

  .reference-login-page__intro p:last-child,
  .reference-recover-form p {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 65%);
  }

  .reference-login-form {
    display: grid;
    gap: 0.6rem;
  }

  .reference-login-form label {
    margin-top: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .reference-login-form input {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid #d9c9d2;
    border-radius: 4px;
    background: #fff;
  }

  .reference-login-form input:focus {
    outline: 2px solid #e5007e;
    outline-offset: 1px;
  }

  .reference-login-form__submit {
    min-height: 3rem;
    margin-top: 0.8rem;
    border: 0;
    border-radius: 4px;
    background: #e5007e;
    color: #fff;
    cursor: pointer;
    font-weight: 700;
  }

  .reference-login-form__submit:hover {
    background: #c9006f;
  }

  .reference-login-form__recover,
  .reference-login-page__register {
    color: #c9006f;
    font-size: 0.9rem;
    text-align: center;
    text-decoration: none;
  }

  .reference-login-form__recover:hover,
  .reference-login-page__register:hover {
    text-decoration: underline;
  }

  .reference-login-page__divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
    color: rgb(var(--color-foreground-rgb) / 55%);
    font-size: 0.8rem;
  }

  .reference-login-page__divider::before,
  .reference-login-page__divider::after {
    flex: 1;
    height: 1px;
    background: #eadde4;
    content: '';
  }

  .reference-login-page__register {
    display: block;
    padding: 0.8rem;
    border: 1px solid #e5007e;
    border-radius: 4px;
  }

  .reference-recover-form {
    display: none;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eadde4;
  }

  .reference-recover-form:target {
    display: block;
  }

  .reference-login-form__error {
    padding: 0.75rem;
    border: 1px solid #e8b3c9;
    border-radius: 4px;
    background: #fff0f5;
    color: #a5004f;
    font-size: 0.85rem;
  }

  .reference-login-form__success {
    color: #24734a;
    font-size: 0.85rem;
  }
</style>
