{%- comment -%}
  "You may also like": Shopify recommendations (AJAX recipe used by Dawn).
  Server-renders when Shopify injects `recommendations`; otherwise theme.js
  fetches {{ routes.product_recommendations_url }}?section_id=… for this section.
{%- endcomment -%}
{%- if product and section.settings.products_per_page > 0 -%}
  <section
    class="evo-related"
    data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_per_page }}"
  >
    <div class="evo-shell">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <h2 class="evo-related__heading font-heading">{{ section.settings.heading | escape }}</h2>
        <div class="evo-related__grid">
          {%- for recommendation in recommendations.products -%}
            {%- render 'product-card', card_product: recommendation -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <h2 class="evo-related__heading font-heading">{{ section.settings.heading | escape }}</h2>
        <div class="evo-related__grid" data-recommendations-grid></div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
