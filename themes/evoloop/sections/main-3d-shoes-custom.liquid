{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
%}

<section class="custom-product-page" data-custom-product-page>
  <div class="custom-product-page__inner">
    <a class="custom-product-page__back" href="{{ routes.all_products_collection_url }}">Back to all shoes</a>

    <div class="custom-product-page__layout">
      <div class="custom-product-page__gallery">
        <div class="custom-product-page__featured-media" data-featured-media>
          {% if featured_image != blank %}
            {{ featured_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 58vw, 100vw', alt: featured_image.alt | default: product.title, loading: 'eager', data-featured-image: '' }}
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'custom-product-page__placeholder' }}
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="custom-product-page__thumbnails" role="list" aria-label="{{ product.title | escape }} images">
            {% for image in product.images %}
              <button type="button" class="custom-product-page__thumbnail{% if image == featured_image %} is-active{% endif %}" data-thumbnail data-image-url="{{ image | image_url: width: 1600 }}" data-image-alt="{{ image.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}">
                {{ image | image_url: width: 180 | image_tag: width: 90, height: 90, alt: image.alt | default: product.title, loading: 'lazy' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="custom-product-page__details">
        <p class="custom-product-page__eyebrow">3D PRINTED FOOTWEAR</p>
        <h1>{{ product.title }}</h1>
        <div class="custom-product-page__price" data-product-price>{{ current_variant.price | money }}</div>
        <div class="custom-product-page__description">{{ product.description }}</div>

        {% form 'product', product, id: 'custom-product-form', class: 'custom-product-page__form', data-product-form: '' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            {% for product_option in product.options_with_values %}
              <fieldset class="custom-product-page__option" data-option-group data-option-position="{{ forloop.index0 }}">
                <legend>{{ product_option.name }}</legend>
                <div class="custom-product-page__option-values" role="radiogroup" aria-label="{{ product_option.name }}">
                  {% for value in product_option.values %}
                    <label class="custom-product-page__option-value">
                      <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option-value data-option-position="{{ forloop.parentloop.index0 }}" {% if product_option.selected_value == value %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endunless %}

          <div class="custom-product-page__purchase-row">
            <label class="custom-product-page__quantity-label" for="CustomProductQuantity">Quantity</label>
            <input id="CustomProductQuantity" class="custom-product-page__quantity" type="number" name="quantity" value="1" min="1">
          </div>

          <button class="custom-product-page__add button" type="submit" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
            <span data-add-label>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
          </button>
          {% if section.settings.show_dynamic_checkout %}
            {{ form | payment_button }}
          {% endif %}
          <p class="custom-product-page__status" data-form-status role="status" aria-live="polite"></p>
        {% endform %}

        <div class="custom-product-page__details-list">
          <details open>
            <summary>Materials and process</summary>
            <p>Digital design, light-cured 3D printing, cleaning, post-curing, finishing, and quality inspection.</p>
          </details>
          <details>
            <summary>Shipping and returns</summary>
            <p>Review the shipping, fit, care, and return terms before checkout.</p>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const page = document.querySelector('[data-custom-product-page]');
    if (!page || page.dataset.initialized === 'true') return;
    page.dataset.initialized = 'true';
    const form = page.querySelector('[data-product-form]');
    const variants = {{ product.variants | json }};
    const price = page.querySelector('[data-product-price]');
    const variantId = page.querySelector('[data-variant-id]');
    const addButton = page.querySelector('[data-add-to-cart]');
    const addLabel = page.querySelector('[data-add-label]');
    const status = page.querySelector('[data-form-status]');
    const thumbnails = [...page.querySelectorAll('[data-thumbnail]')];
    const featuredImage = page.querySelector('[data-featured-image]');
    const formatMoney = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency: '{{ cart.currency.iso_code }}' }).format(cents / 100);

    const selectedOptions = () => {
      const values = [];
      page.querySelectorAll('[data-option-group]').forEach((group) => {
        values.push(group.querySelector('[data-option-value]:checked')?.value || '');
      });
      return values;
    };

    const hasAvailableVariant = (optionPosition, optionValue, selected) => variants.some((item) => {
      if (!item.available || item.options[optionPosition] !== optionValue) return false;
      return item.options.every((value, index) => index === optionPosition || value === selected[index]);
    });

    const updateOptionAvailability = () => {
      const selected = selectedOptions();
      page.querySelectorAll('[data-option-value]').forEach((input) => {
        const position = Number(input.dataset.optionPosition);
        const available = hasAvailableVariant(position, input.value, selected);
        input.disabled = !input.checked && !available;
        input.closest('.custom-product-page__option-value')?.classList.toggle('is-unavailable', input.disabled);
      });
    };

    const updateVariant = () => {
      const selected = selectedOptions();
      const variant = variants.find((item) => item.options.every((value, index) => value === selected[index]));
      if (!variant) {
        updateOptionAvailability();
        addButton.disabled = true;
        addLabel.textContent = 'Unavailable';
        status.textContent = 'Please choose an available combination.';
        return;
      }
      variantId.value = variant.id;
      price.textContent = formatMoney(variant.price);
      addButton.disabled = !variant.available;
      addLabel.textContent = variant.available ? 'Add to cart' : 'Sold out';
      status.textContent = '';
      if (variant.featured_image?.src && featuredImage) {
        featuredImage.src = variant.featured_image.src;
        featuredImage.removeAttribute('srcset');
        featuredImage.alt = variant.name || '{{ product.title | escape }}';
      }
      updateOptionAvailability();
    };

    page.querySelectorAll('[data-option-value]').forEach((input) => input.addEventListener('change', updateVariant));
    thumbnails.forEach((thumbnail) => thumbnail.addEventListener('click', () => {
      if (!featuredImage) return;
      featuredImage.src = thumbnail.dataset.imageUrl;
      featuredImage.alt = thumbnail.dataset.imageAlt;
      thumbnails.forEach((item) => item.classList.toggle('is-active', item === thumbnail));
    }));
    form?.addEventListener('submit', () => {
      status.textContent = 'Adding to cart...';
    });
    updateVariant();
  })();
</script>

{% stylesheet %}
  .custom-product-page { background: #f7f8f4; color: #1d2420; }
  .custom-product-page__inner { width: min(100% - 2rem, 90rem); margin: 0 auto; padding: 1.5rem 0 5rem; }
  .custom-product-page__back { color: inherit; font-size: 0.8rem; text-decoration: none; }
  .custom-product-page__back:hover { text-decoration: underline; }
  .custom-product-page__layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; margin-top: 2rem; }
  .custom-product-page__featured-media { aspect-ratio: 1 / 1; overflow: hidden; background: #fff; }
  .custom-product-page__featured-media img, .custom-product-page__placeholder { display: block; width: 100%; height: 100%; object-fit: contain; }
  .custom-product-page__thumbnails { display: flex; gap: 0.6rem; margin-top: 0.75rem; overflow-x: auto; }
  .custom-product-page__thumbnail { flex: 0 0 5.5rem; padding: 0.2rem; border: 1px solid transparent; background: #fff; cursor: pointer; }
  .custom-product-page__thumbnail.is-active { border-color: #1d2420; }
  .custom-product-page__thumbnail img { display: block; width: 100%; height: 5rem; object-fit: cover; }
  .custom-product-page__details { position: sticky; top: 6rem; }
  .custom-product-page__eyebrow { margin: 0 0 0.75rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; }
  .custom-product-page h1 { margin: 0; font-size: clamp(2rem, 4vw, 4rem); line-height: 1; }
  .custom-product-page__price { margin-top: 1rem; font-size: 1.25rem; font-weight: 700; }
  .custom-product-page__description { margin-top: 1.5rem; line-height: 1.65; }
  .custom-product-page__form { margin-top: 2rem; }
  .custom-product-page__option { padding: 0; border: 0; }
  .custom-product-page__option + .custom-product-page__option { margin-top: 1.25rem; }
  .custom-product-page__option legend { margin-bottom: 0.6rem; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
  .custom-product-page__option-values { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .custom-product-page__option-value { position: relative; }
  .custom-product-page__option-value input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .custom-product-page__option-value span { display: block; min-width: 4rem; padding: 0.75rem 1rem; border: 1px solid #b7beb7; background: #fff; text-align: center; cursor: pointer; }
  .custom-product-page__option-value input:checked + span { border-color: #1d2420; color: #fff; background: #1d2420; }
  .custom-product-page__option-value input:disabled + span { cursor: not-allowed; opacity: 0.35; text-decoration: line-through; }
  .custom-product-page__option-value input:focus-visible + span { outline: 2px solid #1d2420; outline-offset: 2px; }
  .custom-product-page__purchase-row { display: flex; align-items: center; gap: 0.75rem; margin: 2rem 0 0.75rem; }
  .custom-product-page__quantity-label { font-size: 0.8rem; font-weight: 700; }
  .custom-product-page__quantity { width: 5rem; padding: 0.75rem; border: 1px solid #b7beb7; background: #fff; }
  .custom-product-page__add { width: 100%; min-height: 3.25rem; border: 0; color: #fff; background: #1d2420; cursor: pointer; }
  .custom-product-page__add:disabled { cursor: not-allowed; opacity: 0.45; }
  .custom-product-page__form .shopify-payment-button { margin-top: 0.75rem; }
  .custom-product-page__status { min-height: 1.3rem; margin-top: 0.75rem; font-size: 0.8rem; }
  .custom-product-page__details-list { margin-top: 2rem; border-top: 1px solid #ccd1cb; }
  .custom-product-page__details-list details { padding: 1rem 0; border-bottom: 1px solid #ccd1cb; }
  .custom-product-page__details-list summary { cursor: pointer; font-weight: 700; }
  .custom-product-page__details-list p { margin: 0.75rem 0 0; line-height: 1.5; }
  @media screen and (max-width: 749px) {
    .custom-product-page__inner { padding-bottom: 3rem; }
    .custom-product-page__layout { display: block; margin-top: 1.25rem; }
    .custom-product-page__details { position: static; margin-top: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D-shoes product page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show accelerated checkout",
      "default": true
    }
  ]
}
{% endschema %}
