{%- comment -%}
  Generic text section (used by index.json placeholder until the storefront
  landing moves over). Heading + richtext + optional button.
{%- endcomment -%}
<section class="evo-shell evo-text" style="padding-block: clamp(48px, 10vw, 120px)">
  {%- if section.settings.heading != blank -%}
    <h1 class="evo-text__heading font-heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}
  {%- if section.settings.body != blank -%}
    <div class="evo-text__body">{{ section.settings.body }}</div>
  {%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{ section.settings.button_label | escape }}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "3D Printed. Closed-Loop. A New Footwear Phenomenon." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Casual shoes, printed to order in your size.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ]
}
{% endschema %}
