{%- comment -%}
  Evoloop main-product section (spec §9 hard order). Two-column shell:
  media left, product info right; within info the block order is the DOM
  order (title → price → description → variant → … → buy).
  Rendering keeps DOM/reading order = visual order.
{%- endcomment -%}
<section class="evo-product" aria-label="{{ product.title | escape }}">
  {%- if section.settings.show_back_link -%}
    <a class="evo-back" href="{{ routes.all_products_collection_url }}">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      {{ section.settings.back_link_text | escape }}
    </a>
  {%- endif -%}

  {%- comment -%}
    Metafield config (evoloop.*) for the SVG visual fallback. Escaped into
    data attributes; product-visual.js parses. No metafields -> brand defaults.
  {%- endcomment -%}
  {%- liquid
    assign evo_pattern = product.metafields.evoloop.construction_pattern.value | default: 'lattice'
    assign evo_density = product.metafields.evoloop.construction_density.value | default: '0.75'
    assign evo_palette = product.metafields.evoloop.visual_palette.value | default: '["#f3f1ea","#9ca3af"]'
    assign evo_accent = product.metafields.evoloop.visual_accent.value | default: '#0f766e'
    assign evo_subtitle = product.metafields.evoloop.subtitle.value
  -%}

  <div class="evo-product__grid">
    <div class="evo-product__media">
      {%- comment -%}① 商品图：有媒体 → 原生图廊；无媒体 → 3D 视觉三视图（JS 生成）{%- endcomment -%}
      {%- if product.media.size > 0 -%}
        <div class="evo-gallery" data-evo-gallery>
          <img
            class="evo-gallery__main"
            src="{{ product.featured_media.preview_image | image_url: width: 1200 }}"
            alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
            width="1200"
            height="1200"
            loading="eager"
          >
          {%- if product.media.size > 1 -%}
            <div class="evo-gallery__thumbs" role="group" aria-label="{{ product.title | escape }} images">
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="evo-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                  data-evo-gallery-thumb
                  data-src="{{ media.preview_image | image_url: width: 1200 }}"
                  data-alt="{{ media.alt | escape | default: product.title | escape }}"
                  aria-label="{{ media.alt | escape | default: product.title | escape }}"
                >
                  <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div
          class="evo-visual"
          data-evo-visual
          data-pattern="{{ evo_pattern | escape }}"
          data-density="{{ evo_density | escape }}"
          data-palette="{{ evo_palette | escape }}"
          data-accent="{{ evo_accent | escape }}"
          data-name="{{ product.title | escape }}"
        ></div>
      {%- endif -%}
    </div>

    <div class="evo-product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <h1 class="evo-pdp-title font-heading" {{ block.shopify_attributes }}>
              {{ product.title | escape }}
            </h1>
            {%- if evo_subtitle != blank -%}
              <p class="evo-pdp-subtitle">{{ evo_subtitle | escape }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <p class="evo-pdp-price" data-evo-price {{ block.shopify_attributes }}>
              {{ product.selected_or_first_available_variant.price | money }}
            </p>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="evo-pdp-desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            <div class="evo-variants" {{ block.shopify_attributes }}>
              {%- if product.has_only_default_variant -%}
                <p class="evo-variants__none">{{ 'products.product.no_variants' | t }}</p>
              {%- else -%}
                {%- for option in product.options_with_values -%}
                  <fieldset class="evo-option">
                    <legend class="evo-option__label">
                      {{ option.name | escape }}
                      {%- if option.name == 'Size' and section.settings.size_footnote != blank -%}
                        <span class="evo-option__note">{{ section.settings.size_footnote | escape }}</span>
                      {%- endif -%}
                    </legend>
                    <div class="evo-option__chips" role="radiogroup" aria-label="{{ option.name | escape }}">
                      {%- for value in option.values -%}
                        <label class="evo-chip">
                          <input
                            type="radio"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-evo-option
                            data-option-position="{{ option.position }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <span>{{ value | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              {%- endif -%}
            </div>

          {%- when 'assistant_slot' -%}
            {%- if settings.assistant_backend_url != blank -%}
              <div class="evo-assistant" {{ block.shopify_attributes }}>
                <button type="button" class="evo-link" data-evo-find-size>Find my size</button>
                <div
                  data-evo-assistant-root
                  data-backend="{{ settings.assistant_backend_url | escape }}"
                  data-title="{{ product.title | escape }}"
                  data-handle="{{ product.handle | escape }}"
                  data-url="{{ product.url | escape }}"
                ></div>
              </div>
            {%- endif -%}

          {%- when 'collapsible_tab' -%}
            <details class="evo-accordion" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.heading | escape }}
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="evo-accordion__body">
                {%- liquid
                  assign use_product = block.settings.use_product_details
                  assign has_features = product.metafields.evoloop.features.value
                -%}
                {%- if use_product and has_features -%}
                  {%- render 'product-details', product: product -%}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>

          {%- when 'buy_buttons' -%}
            {%- assign current_variant = product.selected_or_first_available_variant -%}
            <form
              class="evo-buy"
              method="post"
              action="/cart/add"
              data-evo-add-form
              {{ block.shopify_attributes }}
            >
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-evo-variant-id>
              <input type="hidden" name="quantity" value="1">
              <button
                type="submit"
                class="btn btn--primary"
                {% unless current_variant.available %}disabled{% endunless %}
                data-evo-submit
              >
                {%- if current_variant.available -%}Add to bag{%- else -%}Sold out{%- endif -%}
              </button>
              <p class="evo-buy__status" role="status" aria-live="polite" data-evo-status></p>
            </form>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%}
    Variant + price data for theme.js. Rendered server-side so currency format
    and availability are always correct per market.
  {%- endcomment -%}
  <script type="application/json" data-evo-variants>
    {%- liquid
      assign variants = product.variants
      if variants.size > 0
        echo '['
        for variant in variants
          unless forloop.first
            echo ','
          endunless
          echo '{'
          echo '"id":' | append: variant.id
          echo ',"available":' | append: variant.available
          echo ',"price":' | append: variant.price | money | json
          echo ',"options":' | append: variant.options | json
          echo '}'
        endfor
        echo ']'
      else
        echo '[]'
      endif
    -%}
  </script>
  <script type="application/json" data-evo-product-context>
    {
      "title": {{ product.title | json }},
      "handle": {{ product.handle | json }},
      "url": {{ product.url | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show back link",
      "default": true
    },
    {
      "type": "text",
      "id": "back_link_text",
      "label": "Back link text",
      "default": "All shoes"
    },
    {
      "type": "text",
      "id": "size_footnote",
      "label": "Size option footnote",
      "info": "Shown under the Size option. Leave blank to hide.",
      "default": ""
    }
  ],
  "blocks": [
    { "type": "media", "name": "Gallery / visual", "settings": [] },
    { "type": "title", "name": "Title", "settings": [] },
    { "type": "price", "name": "Price", "settings": [] },
    { "type": "description", "name": "Description", "settings": [] },
    {
      "type": "variant_picker",
      "name": "Size / variant picker",
      "settings": []
    },
    {
      "type": "assistant_slot",
      "name": "Find my size (Evoloop assistant slot)",
      "info": "Appears only when theme setting Assistant → Backend URL is set. Contract in themes/evoloop/README.md.",
      "settings": []
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Static content (fallback)", "default": "" },
        {
          "type": "checkbox",
          "id": "use_product_details",
          "label": "Use product metafield details (evoloop.features / fit_notes) when present",
          "default": false
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "info": "Add to bag then straight to checkout (no cart page in this theme).",
      "settings": []
    }
  ],
  "default": {
    "blocks": [
      { "type": "media" },
      { "type": "title" },
      { "type": "price" },
      { "type": "description" },
      { "type": "variant_picker" },
      { "type": "assistant_slot" },
      { "type": "collapsible_tab", "settings": { "heading": "Materials & fit" } },
      { "type": "collapsible_tab", "settings": { "heading": "Shipping & returns" } },
      { "type": "buy_buttons" }
    ]
  }
}
{% endschema %}
