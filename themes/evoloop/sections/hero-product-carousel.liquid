{% liquid
  assign slide_count = section.blocks.size
  if slide_count == 0
    assign slide_count = 3
  endif
%}

<section
  id="HeroProductCarousel-{{ section.id }}"
  class="hero-product-carousel"
  data-hero-product-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-slide-count="{{ slide_count }}"
  style="
    --carousel-height: {{ section.settings.height }};
    --carousel-overlay: {{ section.settings.overlay_color }};
  "
>
  {% if section.settings.intro_text != blank %}
    <div class="hero-product-carousel__intro" data-carousel-intro role="status">{{ section.settings.intro_text | escape }}</div>
  {% endif %}
  <div class="hero-product-carousel__viewport" data-carousel-viewport>
    <div class="hero-product-carousel__track" data-carousel-track>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign product = block.settings.product
            assign slide_image = block.settings.image | default: product.featured_image
            assign slide_link = product.url | default: block.settings.link
            assign slide_asset = block.settings.asset_filename
            if forloop.first
              assign image_loading = 'eager'
            else
              assign image_loading = 'lazy'
            endif
          %}
          <article
            class="hero-product-carousel__slide{% if forloop.first %} is-active{% endif %}"
            data-carousel-slide
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {% if slide_link != blank %}<a class="hero-product-carousel__image-link" href="{{ slide_link }}" aria-label="{{ product.title | default: block.settings.heading | escape }}">{% endif %}
              {% if slide_image != blank %}
                {{ slide_image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: image_loading, alt: slide_image.alt | default: product.title | default: block.settings.heading }}
              {% elsif slide_asset != blank %}
                <img src="{{ slide_asset | asset_url }}" width="2400" height="1350" loading="{{ image_loading }}" alt="{{ product.title | default: block.settings.heading | escape }}">
              {% else %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-product-carousel__placeholder' }}
              {% endif %}
            {% if slide_link != blank %}</a>{% endif %}
            <div class="hero-product-carousel__shade"></div>
            <div class="hero-product-carousel__content">
              {% if block.settings.eyebrow != blank %}<p class="hero-product-carousel__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
              <h2 class="hero-product-carousel__title">{{ product.title | default: block.settings.heading | default: '3D printed footwear' | escape }}</h2>
              {% if product != blank %}
                <p class="hero-product-carousel__price">{{ product.price | money }}</p>
              {% endif %}
              {% if block.settings.description != blank %}<p class="hero-product-carousel__description">{{ block.settings.description | escape }}</p>{% endif %}
              {% if slide_link != blank %}
                <a class="hero-product-carousel__button" href="{{ slide_link }}">{{ block.settings.button_label | default: 'View product' | escape }}</a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for placeholder_index in (1..3) %}
          <article class="hero-product-carousel__slide{% if forloop.first %} is-active{% endif %}" data-carousel-slide data-slide-index="{{ forloop.index0 }}">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-product-carousel__placeholder' }}
            <div class="hero-product-carousel__shade"></div>
            <div class="hero-product-carousel__content">
              <h2 class="hero-product-carousel__title">Add a product to this slide</h2>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 1 %}
    <button class="hero-product-carousel__arrow hero-product-carousel__arrow--previous" type="button" data-carousel-previous aria-label="Previous product">
      <span aria-hidden="true">&#8592;</span>
    </button>
    <button class="hero-product-carousel__arrow hero-product-carousel__arrow--next" type="button" data-carousel-next aria-label="Next product">
      <span aria-hidden="true">&#8594;</span>
    </button>
    <div class="hero-product-carousel__dots" role="tablist" aria-label="Featured products">
      {% for block in section.blocks %}
        <button class="hero-product-carousel__dot{% if forloop.first %} is-active{% endif %}" type="button" role="tab" data-carousel-dot="{{ forloop.index0 }}" aria-label="Show product {{ forloop.index }}" aria-selected="{{ forloop.first }}"></button>
      {% endfor %}
    </div>
  {% endif %}
</section>

<script>
  (() => {
    const carousel = document.querySelector('#HeroProductCarousel-{{ section.id }}');
    if (!carousel || carousel.dataset.initialized === 'true') return;
    carousel.dataset.initialized = 'true';
    const track = carousel.querySelector('[data-carousel-track]');
    const slides = [...carousel.querySelectorAll('[data-carousel-slide]')];
    const dots = [...carousel.querySelectorAll('[data-carousel-dot]')];
    const intro = carousel.querySelector('[data-carousel-intro]');
    if (!track || slides.length < 2) return;
    let activeIndex = 0;
    let timer;

    if (intro) window.setTimeout(() => intro.classList.add('is-hidden'), 1000);

    const render = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${activeIndex * 100}%)`;
      slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === activeIndex));
      dots.forEach((dot, dotIndex) => {
        const selected = dotIndex === activeIndex;
        dot.classList.toggle('is-active', selected);
        dot.setAttribute('aria-selected', selected);
      });
    };

    const restart = () => {
      window.clearInterval(timer);
      if (carousel.dataset.autoplay !== 'false' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = window.setInterval(() => render(activeIndex + 1), 5000);
      }
    };

    carousel.querySelector('[data-carousel-previous]')?.addEventListener('click', () => { render(activeIndex - 1); restart(); });
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => { render(activeIndex + 1); restart(); });
    dots.forEach((dot) => dot.addEventListener('click', () => { render(Number(dot.dataset.carouselDot)); restart(); }));
    carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
    carousel.addEventListener('mouseleave', restart);
    render(0);
    restart();
  })();
</script>

{% stylesheet %}
  .hero-product-carousel {
    position: relative;
    min-height: var(--carousel-height);
    overflow: hidden;
    color: #fff;
    background: #1d2420;
  }

  .hero-product-carousel__viewport,
  .hero-product-carousel__track,
  .hero-product-carousel__slide,
  .hero-product-carousel__image-link,
  .hero-product-carousel__slide > img,
  .hero-product-carousel__placeholder {
    min-height: inherit;
  }

  .hero-product-carousel__intro {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    z-index: 3;
    padding: 0.6rem 1rem;
    border: 1px solid rgb(255 255 255 / 45%);
    color: #fff;
    background: rgb(0 0 0 / 22%);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 1;
    transform: translateX(-50%);
    transition: opacity 350ms ease, transform 350ms ease;
    pointer-events: none;
  }

  .hero-product-carousel__intro.is-hidden {
    opacity: 0;
    transform: translate(-50%, -0.5rem);
  }

  .hero-product-carousel__viewport { overflow: hidden; }

  .hero-product-carousel__image-link {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-product-carousel__image-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-product-carousel__track {
    display: flex;
    min-height: inherit;
    transition: transform 650ms cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }

  .hero-product-carousel__slide {
    position: relative;
    flex: 0 0 100%;
    isolation: isolate;
  }

  .hero-product-carousel__image-link,
  .hero-product-carousel__slide > img,
  .hero-product-carousel__placeholder {
    display: block;
    width: 100%;
  }

  .hero-product-carousel__slide > img,
  .hero-product-carousel__placeholder { object-fit: cover; }

  .hero-product-carousel__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, var(--carousel-overlay) 0%, rgb(0 0 0 / 12%) 60%, rgb(0 0 0 / 0%) 100%);
  }

  .hero-product-carousel__content {
    position: absolute;
    bottom: clamp(5rem, 10vw, 8rem);
    left: clamp(1.25rem, 7vw, 7rem);
    z-index: 2;
    max-width: min(34rem, calc(100% - 2.5rem));
  }

  .hero-product-carousel__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-product-carousel__title { margin: 0; font-size: clamp(2rem, 5vw, 5rem); line-height: 0.98; }
  .hero-product-carousel__price { margin: 1rem 0 0; font-size: 1.1rem; }
  .hero-product-carousel__description { max-width: 30rem; margin: 0.75rem 0 0; line-height: 1.5; }

  .hero-product-carousel__button {
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 0.85rem 1.2rem;
    color: inherit;
    border: 1px solid rgb(255 255 255 / 80%);
    text-decoration: none;
  }

  .hero-product-carousel__button:hover { background: #fff; color: #1d2420; }
  .hero-product-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 50%;
    color: #fff;
    background: rgb(0 0 0 / 18%);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .hero-product-carousel__arrow--previous { left: 1rem; }
  .hero-product-carousel__arrow--next { right: 1rem; }
  .hero-product-carousel__dots { position: absolute; right: 1.5rem; bottom: 1.5rem; z-index: 2; display: flex; gap: 0.5rem; }
  .hero-product-carousel__dot { width: 2.25rem; height: 0.25rem; padding: 0; border: 0; background: rgb(255 255 255 / 45%); cursor: pointer; }
  .hero-product-carousel__dot.is-active { background: #fff; }

  @media screen and (max-width: 749px) {
    .hero-product-carousel { min-height: max(36rem, var(--carousel-height)); }
    .hero-product-carousel__content { right: 1.25rem; bottom: 4.5rem; left: 1.25rem; }
    .hero-product-carousel__title { font-size: clamp(2rem, 12vw, 3.5rem); }
    .hero-product-carousel__arrow { width: 2.25rem; height: 2.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-product-carousel__track { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D product carousel",
  "tag": "section",
  "class": "hero-product-carousel-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "intro_text",
      "label": "Intro prompt",
      "default": "Designed to move with you"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hero height",
      "options": [
        { "value": "56svh", "label": "Medium" },
        { "value": "72svh", "label": "Large" },
        { "value": "100svh", "label": "Full screen" }
      ],
      "default": "72svh"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#10141299"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate automatically",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Slide image" },
        { "type": "text", "id": "asset_filename", "label": "Bundled asset filename" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to move" },
        { "type": "text", "id": "heading", "label": "Fallback heading", "default": "3D printed footwear" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View product" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "3D product carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
