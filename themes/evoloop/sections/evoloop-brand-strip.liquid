{%- comment -%}
  Evoloop slogan strip — full-width bottom band under the footer utilities,
  mirroring the tagline bar on the Evoloop Next.js site footer. Loaded as the
  last section of the footer section-group on every page.
{%- endcomment -%}
<section class="evo-slogan-strip">
  <div class="evo-slogan-strip__inner">
    <p class="evo-slogan-strip__text">{{ section.settings.tagline }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Evoloop slogan strip",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "3D Printed. Closed-Loop. A New Footwear Phenomenon."
    }
  ]
}
{% endschema %}
